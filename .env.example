
# Postgres owner role, used by the crawler, dbt and the recommender
POSTGRES_USER=pricewatch
POSTGRES_PASSWORD=pricewatch_dev
POSTGRES_DB=pricewatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port on your machine (5433 avoids clashing with a local Postgres on 5432)
POSTGRES_HOST_PORT=5433

# Least-privilege roles (db/init/004_roles.sh): they can only read gold
API_DB_PASSWORD=api_app_dev
BI_READER_PASSWORD=bi_reader_dev

# API (JWT). Demo users: analyst / analyst123 and admin / admin123
JWT_SECRET=change-me-to-a-long-random-string-0123456789
JWT_EXPIRE_MINUTES=60
# bcrypt hashes; single quotes stop docker compose from reading "$2b" as a variable.
API_ANALYST_PASSWORD_HASH='$2b$12$vJL2eAQty5DDBrfsfjNO0.UwzyUHHLOwq/KQxs38v/wJRzCUCwM.m'
API_ADMIN_PASSWORD_HASH='$2b$12$Rbhj5ykVnw3mhh3/VAPeLeexKT6X0mRqWo5e8322lCTMw0AEFlHTe'
API_HOST_PORT=8000

# Superset (8088 on the host)
SUPERSET_HOST_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=Pricewatch-demo-1
# Superset refuses to start with its default key. Demo value only.
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string-9876543210-superset

# Pipeline
LOG_LEVEL=INFO
# true = never contact Tokopedia; use sample data + already landed HTML only
SKIP_LIVE_CRAWL=false
# Optional: URL that receives a POST when a crawl run is degraded / failed / blocked
ALERT_WEBHOOK_URL=
DBT_DOCS_HOST_PORT=8080
# Dagster UI (bonus orchestrator, profile "orchestrator")
DAGSTER_HOST_PORT=3000
